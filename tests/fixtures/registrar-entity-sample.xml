    <body>
      <part eId="part-I">
        <num>Part I</num>
        <heading>Preliminary</heading>
        <section eId="part-I__sec-5">
          <num>5</num>
          <heading>Interpretation</heading>
          <content>
            <p><term refersTo="#term-registrar">Registrar</term> means <def>a person appointed to register marriages under this Act.</def></p>
            <p><term refersTo="#term-purpose">purpose</term> means <def>the object for which a thing is done.</def></p>
          </content>
        </section>
        <section eId="part-II__sec-10">
          <num>10</num>
          <heading>Functions</heading>
          <content>
            <p>The Registrar must keep a register of marriages.</p>
            <p>The Registrar may delegate this function.</p>
          </content>
        </section>
      </part>
