      <part eId="part-I">
        <num>Part I</num>
        <heading>Preliminary</heading>
        <section eId="part-I__sec-6">
          <num>6</num>
          <heading>Definitions</heading>
          <content>
            <p>In this Act, unless the contrary intention appears, terms have their ordinary meaning.</p>
          </content>
        </section>
        <section eId="part-I__sec-13">
          <num>13</num>
          <heading>Application</heading>
          <content>
            <p>This section applies subject to section 6.</p>
            <p>Nothing in section 6 limits subsection 6(2).</p>
            <p>See also <ref href="#part-I__sec-6">section 6</ref> for the relevant definitions.</p>
            <p>Subsection (2) does not apply.</p>
          </content>
