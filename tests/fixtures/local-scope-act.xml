      <section eId="part-I__sec-2">
        <num>2</num>
        <heading>Definitions</heading>
        <content>
          <p><term refersTo="#term-use">use</term> means <def>apply for any purpose.</def></p>
        </content>
      </section>
      <section eId="part-I__sec-5">
        <num>5</num>
        <heading>Protection of confidential information</heading>
        <content>
          <p><term refersTo="#term-use--part-I__sec-5">use</term> means <def>make use of the information in a document.</def></p>
          <p><term refersTo="#term-disclose--part-I__sec-5">disclose</term> means <def>divulge or communicate.</def></p>
        </content>
        <subsection eId="part-I__sec-5__subsec-1">
          <num>(1)</num>
          <content><p>A person must not disclose or use the information.</p></content>
        </subsection>
      </section>
      <section eId="part-I__sec-6">
        <num>6</num>
        <heading>Other</heading>
        <content><p>A person may use a thing.</p></content>
